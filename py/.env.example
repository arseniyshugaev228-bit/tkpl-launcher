# Скопируй этот файл в py/.env и заполни.
#
# SMTP_PASSWORD — это НЕ обычный пароль от почты, а «пароль приложения» Google:
#   1. Включи двухэтапную аутентификацию: https://myaccount.google.com/security
#   2. Создай пароль приложения: https://myaccount.google.com/apppasswords
#   3. Вставь 16 символов ниже (пробелы можно оставить)

# с какого ящика отправлять (можно тот же, куда приходят отзывы)
SMTP_USER=you@example.com
SMTP_PASSWORD=

# куда присылать отзывы
FEEDBACK_TO=you@example.com

# сервер почты (для Gmail менять не нужно)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# где слушать сайт. Для хостинга поставь HOST=0.0.0.0
HOST=127.0.0.1
PORT=8000
